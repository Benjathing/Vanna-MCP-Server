{
  "type": "Microsoft.App/containerApps",
  "name": "aca-is-vanna-dev-ae-04",
  "resourceGroup": "rg-is-gpt-dev-aue",
  "location": "australiaeast",
  "properties": {
    "template": {
      "volumes": [
        {
          "name": "qdrant-data",
          "storageType": "EmptyDir"
        },
        {
          "name": "c--docker-vannamcp-vanna-mcp-server-docker-logs",
          "storageType": "EmptyDir"
        }
      ],
      "scale": {
        "minReplicas": 1,
        "maxReplicas": 3
      },
      "containers": [
        {
          "env": [
            {
              "value": "6333",
              "name": "QDRANT__SERVICE__GRPC_PORT"
            },
            {
              "value": "6333",
              "name": "QDRANT__SERVICE__HTTP_PORT"
            }
          ],
          "resources": {
            "memory": "1.0Gi",
            "cpu": 0.5
          },
          "name": "qdrant",
          "image": "qdrant/qdrant:latest",
          "volumeMounts": [
            {
              "volumeName": "qdrant-data",
              "mountPath": "/qdrant/data"
            }
          ]
        },
        {
          "env": [
            {
              "value": "False",
              "name": "ANONYMIZED_TELEMETERY"
            },
            {
              "value": "Project descriptions, budgets, and start dates for different Clients",
              "name": "DB_DESCRIPTION"
            },
            {
              "value": "https://openai-aueast.openai.azure.com",
              "name": "AZURE_OPENAI_ENDPOINT"
            },
            {
              "value": "Driver={ODBC Driver 18 for SQL Server};Server=tcp:sql-is-vanna-d-ae-01.database.windows.net,1433;Database=sqldbis-vanna-d-ae-01;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;",
              "name": "ODBC_CONN_STRING"
            },
            {
              "value": "8002",
              "name": "WEB_SERVER_PORT"
            },
            {
              "value": "http://qdrant:6333",
              "name": "QDRANT_URL"
            },
            {
              "value": "8000",
              "name": "MCP_SERVER_PORT"
            },
            {
              "secretRef": "OPENAI_API_KEY",
              "name": "OPENAI_API_KEY"
            },
            {
              "value": "8001",
              "name": "MCPO_SERVER_PORT"
            },
            {
              "value": "/app/logs/excel_log.xlsx",
              "name": "EXCEL_LOG_PATH"
            }
          ],
          "resources": {
            "memory": "1.0Gi",
            "cpu": 0.5
          },
          "name": "vanna-mcp-server",
          "image": "crbdllmprodase01.azurecr.io/vanna-mcp-server-qdrant:latest",
          "volumeMounts": [
            {
              "volumeName": "c--docker-vannamcp-vanna-mcp-server-docker-logs",
              "mountPath": "/app/logs"
            }
          ]
        }
      ]
    },
    "environmentId": "/subscriptions/a62cf7f5-1856-4cac-9748-fd26fee7c27d/resourceGroups/rg-is-gpt-dev-aue/providers/Microsoft.App/managedEnvironments/acae-is-gpt-dev-aue-03",
    "configuration": {
      "secrets": [
        {
          "value": "2b9b5ba214ab41aeb3d89617c91f3dc2",
          "name": "OPENAI_API_KEY"
        }
      ],
      "ingress": {
        "targetPort": 3000,
        "external": true
      }
    }
  }
}
